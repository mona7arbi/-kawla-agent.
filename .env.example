# Copy to .env and fill in. Never commit .env.
# Free OpenRouter key: https://openrouter.ai/keys  (free models: 50 requests/day; 10 credits once → 1,000/day)
OPENROUTER_API_KEY=

# Optional overrides (defaults are the course's free models)
# AGENT_MODEL=google/gemma-4-31b-it:free
# AGENT_SMALL_MODEL=google/gemma-4-26b-a4b-it:free        # used by the LLM judge
# AGENT_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# AGENT_CACHE=1                                           # 0 = always call the model (needed for pass^k)

# Or call OpenAI directly with your own key (no daily limit; paid per token):
# AGENT_PROVIDER=custom
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini
